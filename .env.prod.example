# Copy this file to .env.prod on the server and fill in every value. Never commit .env.prod.

# Database (choose a long random password)
POSTGRES_DB=erp
POSTGRES_USER=erp
POSTGRES_PASSWORD=CHANGE_ME

# Django
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
# Your domain, or the server IP if you have no domain yet
DJANGO_ALLOWED_HOSTS=erp.example.com
# Same address with http:// or https:// in front
CSRF_TRUSTED_ORIGINS=https://erp.example.com

# Web address Caddy serves.
# With a domain:  SITE_ADDRESS=erp.example.com  (HTTPS is set up automatically)  and USE_HTTPS=1
# With only an IP: SITE_ADDRESS=:80  (plain HTTP, for a short demo only)  and USE_HTTPS=0
SITE_ADDRESS=erp.example.com
USE_HTTPS=1

# Printed on invoices
SHOP_NAME=Your shop name
SHOP_GSTIN=
SHOP_ADDRESS=
SHOP_PHONE=
SHOP_STATE_CODE=33
PRICES_INCLUDE_GST=0
COUNTER_MAX_DISCOUNT_PERCENT=10
